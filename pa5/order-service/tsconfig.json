{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    // shared/rabbit.ts lives one level up from this service and imports
    // "amqplib" itself. At runtime that resolves fine — this service's
    // Dockerfile links its node_modules at /node_modules, where Node looks
    // when resolving from the /shared mount. For a *local* `tsc
    // --noEmit` (there is no such nesting on disk outside the container),
    // point the bare specifier at this service's own install instead.
    "baseUrl": ".",
    "paths": {
      "amqplib": ["./node_modules/@types/amqplib/index.d.ts"]
    }
  },
  // shared/ is a sibling directory mounted read-only into the container at
  // runtime (see ../docker-compose.yml) and imported by relative path
  // ("../shared/rabbit") — included here so `tsc --noEmit` type-checks it
  // together with this service, the same way node resolves it at runtime.
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
