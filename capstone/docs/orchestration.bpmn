<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:message id="Msg_accepted" name="order.accepted"/>
<bpmn:error id="Err_provider" name="provider rejects" errorCode="4xx"/>
<bpmn:error id="Err_step" name="step fails" errorCode="step_failed"/>
<bpmn:process id="checkout" name="Checkout saga" isExecutable="false">
<bpmn:documentation>Simplified view of the saga. A b2b order skips payment. For b2b the first step is inventory, and its failure follows the first-step path (failed, or retry then parked) instead of the compensation path. The needs_attention outcome (crash detection) is operational and is not modelled here.</bpmn:documentation>
<bpmn:startEvent id="Start" name="order.accepted from saga.queue"><bpmn:messageEventDefinition messageRef="Msg_accepted"/></bpmn:startEvent>
<bpmn:exclusiveGateway id="GwDup" name="businessKey already seen?"/>
<bpmn:exclusiveGateway id="GwB2b" name="orderType is b2b?"/>
<bpmn:serviceTask id="Payment" name="payment: authorize"/>
<bpmn:serviceTask id="Inventory" name="inventory: reserve"/>
<bpmn:serviceTask id="Shipping" name="shipping: create"/>
<bpmn:serviceTask id="Notification" name="notification: send"/>
<bpmn:boundaryEvent id="PayErr" name="declined (4xx)" attachedToRef="Payment"><bpmn:errorEventDefinition errorRef="Err_provider"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="PayTimer" name="5xx or timeout: retry path" attachedToRef="Payment"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2.5S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="PayComp" name="compensable" attachedToRef="Payment"><bpmn:compensateEventDefinition/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="InvErr" name="inventory fails" attachedToRef="Inventory"><bpmn:errorEventDefinition errorRef="Err_step"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="InvComp" name="compensable" attachedToRef="Inventory"><bpmn:compensateEventDefinition/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="ShipErr" name="shipping fails" attachedToRef="Shipping"><bpmn:errorEventDefinition errorRef="Err_step"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="ShipTimer" name="timeout" attachedToRef="Shipping"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2.5S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="NotErr" name="notification fails" attachedToRef="Notification"><bpmn:errorEventDefinition errorRef="Err_step"/></bpmn:boundaryEvent>
<bpmn:serviceTask id="HRefund" name="payment: refund" isForCompensation="true"/>
<bpmn:serviceTask id="HRelease" name="inventory: release" isForCompensation="true"/>
<bpmn:intermediateThrowEvent id="ThrowComp" name="compensate completed steps, reverse order"><bpmn:compensateEventDefinition/></bpmn:intermediateThrowEvent>
<bpmn:exclusiveGateway id="GwComp" name="all compensations succeeded?"/>
<bpmn:endEvent id="EndCompleted" name="completed"/>
<bpmn:endEvent id="EndDuplicate" name="duplicate"/>
<bpmn:endEvent id="EndFailed" name="failed"/>
<bpmn:endEvent id="EndParked" name="parked (DLQ)"/>
<bpmn:endEvent id="EndCompensated" name="compensated"/>
<bpmn:endEvent id="EndCompFailed" name="compensation_failed"/>
<bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="GwDup"/>
<bpmn:sequenceFlow id="f2" sourceRef="GwDup" targetRef="GwB2b" name="no"/>
<bpmn:sequenceFlow id="f3" sourceRef="GwDup" targetRef="EndDuplicate" name="yes"/>
<bpmn:sequenceFlow id="f4" sourceRef="GwB2b" targetRef="Payment" name="standard or express"/>
<bpmn:sequenceFlow id="f5" sourceRef="GwB2b" targetRef="Inventory" name="b2b: no payment"/>
<bpmn:sequenceFlow id="f6" sourceRef="Payment" targetRef="Inventory"/>
<bpmn:sequenceFlow id="f7" sourceRef="Inventory" targetRef="Shipping"/>
<bpmn:sequenceFlow id="f8" sourceRef="Shipping" targetRef="Notification"/>
<bpmn:sequenceFlow id="f9" sourceRef="Notification" targetRef="EndCompleted"/>
<bpmn:sequenceFlow id="f10" sourceRef="PayErr" targetRef="EndFailed"/>
<bpmn:sequenceFlow id="f11" sourceRef="PayTimer" targetRef="EndParked"/>
<bpmn:sequenceFlow id="f12" sourceRef="InvErr" targetRef="ThrowComp"/>
<bpmn:sequenceFlow id="f13" sourceRef="ShipErr" targetRef="ThrowComp"/>
<bpmn:sequenceFlow id="f14" sourceRef="ShipTimer" targetRef="ThrowComp"/>
<bpmn:sequenceFlow id="f15" sourceRef="NotErr" targetRef="ThrowComp"/>
<bpmn:sequenceFlow id="f16" sourceRef="ThrowComp" targetRef="GwComp"/>
<bpmn:sequenceFlow id="f17" sourceRef="GwComp" targetRef="EndCompensated" name="yes"/>
<bpmn:sequenceFlow id="f18" sourceRef="GwComp" targetRef="EndCompFailed" name="no"/>
<bpmn:association id="a1" associationDirection="One" sourceRef="PayComp" targetRef="HRefund"/>
<bpmn:association id="a2" associationDirection="One" sourceRef="InvComp" targetRef="HRelease"/>
</bpmn:process>
